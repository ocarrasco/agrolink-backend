# Stop Lombok from looking at parent directories for more config.
config.stopBubbling = true

# Annotate every Lombok-generated member (constructors from @RequiredArgsConstructor,
# getters/setters, equals/hashCode, ...) with @lombok.Generated. JaCoCo and SonarQube both
# skip @Generated code, so the synthetic @RequiredArgsConstructor constructors stop showing
# up as uncovered lines / Sonar findings — no need to hand-write or exclude constructors.
lombok.addLombokGeneratedAnnotation = true
